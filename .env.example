# Groq (OpenAI-compatible chat completions). Copy to .env and fill in.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
ALLOWED_ORIGIN=http://localhost:8000
LLM_MOCK=0

# Optional: Anakin (anakin.io) powers the official-label lookup. The keyless free tier works without a key;
# set a key to use your own credits.
ANAKIN_API_KEY=
